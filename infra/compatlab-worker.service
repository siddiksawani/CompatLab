[Unit]
Description=CompatLab execution worker
After=network-online.target docker.service wg-quick@wg-compatlab.service
Requires=docker.service wg-quick@wg-compatlab.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/compatlab/current
EnvironmentFile=/etc/compatlab/worker.env
ExecStart=/opt/compatlab-node/bin/node services/worker/dist/remote/bin.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0077
# Workspace mounts must remain visible to the VM's Docker daemon.
PrivateMounts=false
StandardOutput=journal
StandardError=journal
SyslogIdentifier=compatlab-worker

[Install]
WantedBy=multi-user.target
