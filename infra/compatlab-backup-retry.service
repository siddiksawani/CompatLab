[Unit]
Description=Retry pending CompatLab encrypted backup uploads
After=docker.service network-online.target wg-quick@wg-compatlab.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/compatlab/current
EnvironmentFile=/etc/compatlab/backup.env
Environment=BACKUP_RETRY_ONLY=true
ExecStart=/usr/bin/flock -w 60 /run/compatlab-backup.lock /opt/compatlab-node/bin/node infra/backup.mjs
UMask=0077
TimeoutStartSec=2h
SyslogIdentifier=compatlab-backup-retry
