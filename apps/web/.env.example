DATABASE_URL=postgres://compatlab:CHANGE_ME@127.0.0.1:5432/compatlab
PUBLIC_ORIGIN=http://127.0.0.1:3000
PUBLIC_MATRIX_ID=
REQUESTER_SECRET=
PUBLIC_SCANS_ENABLED=false
# Required outside loopback development. The reverse proxy overwrites this header.
PROXY_SECRET=
NEXT_TELEMETRY_DISABLED=1
# Maintainer accounts stay disabled until a GitHub App is configured.
MAINTAINER_AUTH_ENABLED=false
# AUTH_SECRET=64-lowercase-hex-characters
# GITHUB_CLIENT_ID=GitHub-App-client-ID
# GITHUB_CLIENT_SECRET=GitHub-App-client-secret
# GITHUB_APP_ID=numeric-App-ID
# GITHUB_APP_SLUG=app-slug
# GITHUB_WEBHOOK_SECRET=64-lowercase-hex-characters
MAINTAINER_EMAIL_ENABLED=false
