{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "packages/*/test/**/*.ts",
    "services/*/test/**/*.ts",
    "apps/*/test/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["tests/browser", "apps/web/test"]
}
